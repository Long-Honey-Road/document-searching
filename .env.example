# Скопировать в .env и заполнить. Значения ниже — для локальной разработки.
ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080

# --- LLM: внешний OpenAI-совместимый сервер ---
LLM_BASE_URL=http://llm.internal:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=Qwen/Qwen3.8-27B
# Переопределения по ролям (пусто = LLM_MODEL)
LLM_AGENT_MODEL=
LLM_GUARD_MODEL=
GUARD_MODE=json_schema
LLM_EXTRACT_MODEL=
LLM_KEYWORD_MODEL=
LLM_JUDGE_MODEL=
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=8
# Доп. параметры тела запроса, зависят от сервера модели (JSON)
LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}

# --- Эмбеддинги и реранк демо через Ollama на хосте ---
EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDINGS_MODEL=bge-m3:latest
# На Apple Silicon для TEI укажите тег cpu-arm64-1.10 вместо cpu-1.10.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.10
EMBEDDINGS_DIM=1024
RERANK_MODE=embeddings
RERANK_BASE_URL=http://reranker:80
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.2
RERANK_CANDIDATE_LIMIT=24
RERANK_TEXT_MAX_CHARS=384

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
APP_DB=app
APP_DB_USER=app
APP_DB_PASSWORD=change-me
KNOWLEDGE_DB=knowledge
KNOWLEDGE_DB_USER=knowledge
KNOWLEDGE_DB_PASSWORD=change-me
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# --- RabbitMQ ---
RABBITMQ_USER=regagent
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://regagent:change-me@rabbitmq:5672/

# --- Keycloak / OIDC ---
# Пароли Keycloak применяются ТОЛЬКО при первом старте Keycloak (создание администратора
# master и импорт realm). Менять потом — в админке Keycloak или через kcadm.sh
# (deploy/prod/README.md, «Учётки»), правка .env на работающий Keycloak не действует.
# Администратор самого Keycloak (realm master). Входить: <PUBLIC_BASE_URL>/auth/admin/
# Это НЕ учётка приложения: на странице входа RegAgent она не работает.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/regagent
KEYCLOAK_AUDIENCE=regagent-web
# Ключи — по внутреннему адресу; iss проверяется по KEYCLOAK_ISSUER (внешнему)
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/regagent/protocol/openid-connect/certs
JWKS_CACHE_TTL_S=300
JWKS_MIN_REFRESH_S=30
JWT_LEEWAY_S=30
WEB_DEV_BASE_URL=http://localhost:5173
# Демо-учётки realm regagent (логины — в deploy/keycloak/regagent-realm.json).
# Входить: страница входа приложения <PUBLIC_BASE_URL>.
# логин employee_public — сотрудник, только открытые документы
KEYCLOAK_EMPLOYEE_PUBLIC_PASSWORD=replace-me
# логин employee_fin — сотрудник с закрытым финансовым уровнем (группа /levels/closed_fin)
KEYCLOAK_EMPLOYEE_FIN_PASSWORD=replace-me
# логин qc_expert — эксперт ОКК
KEYCLOAK_QC_EXPERT_PASSWORD=replace-me
# логин admin — администратор ПРИЛОЖЕНИЯ (realm regagent). Не путать с KEYCLOAK_ADMIN выше:
# логин тот же, пароль и место входа другие.
KEYCLOAK_ADMIN_DEMO_PASSWORD=replace-me
ACCESS_LEVELS_FILE=config/access_levels.yaml

# --- knowledge ---
KNOWLEDGE_URL=http://knowledge:8000
KNOWLEDGE_INTERNAL_TOKEN=change-me
# Ожидание ответа knowledge: поиск идёт несколько секунд (D-24)
KNOWLEDGE_TIMEOUT_S=30
DOCS_DIR=/data/docs
OKF_DIR=/data/okf
WATCH_DEBOUNCE_S=3
INDEX_MAX_RETRIES=3
INDEX_JOB_TIMEOUT_S=1800
CHUNK_MAX_TOKENS=1200
SEARCH_TOP_K=8
SEARCH_MODE=mix
# Рабочий каталог LightRAG (якорь конфигурации); на стенде — постоянный том
LIGHTRAG_WORKING_DIR=/data/lightrag
# Повторные проходы извлечения сущностей: каждый удваивает вызовы LLM при индексации
LIGHTRAG_EXTRACT_GLEANING=1
LIGHTRAG_LANGUAGE=Russian
LIGHTRAG_EXTRACTION_JSON=false

# --- Агент ---
# Коды областей через запятую (справочник на этап 1)
AREA_CODES=ДИБ,ДБРЦТ,общий
AGENT_ESCALATE_AFTER=2
AGENT_MAX_STEPS=12
# Поисков на один ответ и текста фрагментов модели за один поиск (D-24)
AGENT_MAX_SEARCHES=3
TOOL_RESULT_MAX_CHARS=12000
MEMORY_AREA_TTL_DAYS=14
MEMORY_MAX_ACTIVE_AREAS=3
# Прямых указаний области (в вопросе или в ответе на уточнение) до записи в пустую память
MEMORY_AREA_SIGNALS_TO_REMEMBER=2
# Указаний другой области подряд до смены области в памяти
MEMORY_AREA_SIGNALS_TO_SWITCH=3
# Сколько дней указание учитывается
MEMORY_AREA_SIGNAL_WINDOW_DAYS=14
QUESTION_MAX_CHARS=2000
RATE_LIMIT_PER_USER_PER_MIN=20
AUDIT_RETENTION_DAYS=90

# --- ОКК и почта ---
QC_CLUSTER_SIMILARITY=0.85
QC_NOTIFY_TO=qc@example.org
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=regagent@example.org

# --- web (на этапе сборки) ---
VITE_API_URL=/api
VITE_OIDC_AUTHORITY=http://localhost:8080/auth/realms/regagent
VITE_OIDC_CLIENT_ID=regagent-web
VITE_ASSISTANT_ID=
