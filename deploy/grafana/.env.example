# Копия этого файла — .env рядом с compose.yaml. В git .env не попадает.

# Токен коннектора ОТДЕЛЬНОГО туннеля Grafana (не туннеля стенда)
TUNNEL_TOKEN=

# Пароль admin в Grafana; применяется только при первом старте
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin

# Полный путь к папке logs выкатки (оттуда читается events.jsonl), например /Users/name/srv/regagent_prod/logs
REGAGENT_LOGS_DIR=

# Compose-проект стенда, чьи контейнеры читаются
REGAGENT_PROJECT=regagent-prod

# Порт Grafana на loopback Mac для проверки без туннеля
GRAFANA_PORT=13000
