      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {event=\"turn.result\"} | json | unwrap duration_ms | __error__=\"\" [$__range]) by (event) / 1000",
