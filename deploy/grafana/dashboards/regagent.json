      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({status=~\"error|timeout|failed|unavailable\"} [$__range]))",
          "queryType": "instant",
