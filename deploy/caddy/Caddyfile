{
	auto_https off
}

:8080 {
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Move browser entry to the configured origin before OIDC stores PKCE state.
	@loopbackAlias {
		host localhost 127.0.0.1
		path /
		method GET HEAD
		expression `{scheme} + "://" + {hostport} != "{$PUBLIC_BASE_URL:http://localhost:8080}"`
	}
	redir @loopbackAlias {$PUBLIC_BASE_URL:http://localhost:8080}{uri} 302

	handle /robots.txt {
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	# Лимит по IP добавляется плагином rate_limit (задача P0-3); лимит на учётку — в backend.
	handle_path /api/* {
		reverse_proxy backend:8000
	}
	handle /auth/* {
		# Консоль администратора и master realm снаружи не отдаём (D-47):
		# стенд открыт через Cloudflare Bypass, админка — kcadm.sh в контейнере keycloak.
		@keycloakAdmin path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/*
		respond @keycloakAdmin 404
		reverse_proxy keycloak:8080
	}
	handle {
		reverse_proxy web:80
	}
}
